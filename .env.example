NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000

# Database
DATABASE_FILE=./data/thumari.sqlite3

# Security & Sessions
SESSION_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars-long

# Group Configuration
ORG_NAME=Thumari SACCO
ORG_TAGLINE=Empowering Community Savings and Investments
CURRENCY=TZS
CURRENCY_SYMBOL=TSh
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
LOCALE=en-GB

# Web Push / VAPID (Generate via `npm run vapid:generate`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@thumari.local

# Android TWA & Digital Asset Links
# SHA-256 fingerprint of your release/debug keystore (Colon separated)
ANDROID_CERT_FINGERPRINTS=14:6D:E9:7D:0F:52:AB:E6:EC:65:C4:B8:BC:21:AE:B8:70:50:C0:79:02:4F:10:04:6D:4D:09:9B:0F:7B:6C:A5
ANDROID_PACKAGE_NAME=app.thumari.twa
ANDROID_APK_URL=/static/downloads/thumari.apk
