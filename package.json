{
  "name": "thumari",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Thumari SACCO/Chama management system - PWA & Android APK",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/db/seed.ts",
    "vapid:generate": "tsx scripts/generate-vapid.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^10.0.2",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.38.4",
    "ejs": "^3.1.10",
    "fastify": "^5.2.1",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.13.9",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
