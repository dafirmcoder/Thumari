<%- include('../partials/head.ejs', { title: 'Sign In' }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 420px; margin: 3rem auto;">
  <div class="card">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="/static/images/logo.png" alt="Logo" width="96" height="96" style="border-radius: 50%; margin-bottom: 0.75rem; box-shadow: 0 4px 14px rgba(0,0,0,0.35); object-fit: contain;">
      <h2 style="margin: 0; color: #38bdf8;"><%= org.name %></h2>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.25rem;"><%= org.tagline %></p>
    </div>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="nextUrl" value="<%= nextUrl %>">

      <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">Sign In</button>
    </form>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
