<%- include('../partials/head.ejs', { title: 'Financial Reports' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">?? Financial Reports & Accounts</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">
      Member Contributions, Commercial Projects, Expenses, Coffee Yields & Dividends
    </p>
  </div>

  <button onclick="window.print()" class="btn btn-secondary btn-sm">??? Print Report</button>
</div>

<!-- Report Navigation Cards -->
<div class="grid grid-3" style="margin-bottom: 1.5rem; gap: 1.25rem;">
  <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">??</div>
      <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem;">Financial Accounts Statement</h3>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
        Comprehensive income statement: Member Contributions, Project Earnings, Categorized Expenses & Net Surplus.
      </p>
    </div>
    <a href="/reports/accounts?year=<%= currentYear %>" class="btn btn-primary btn-sm" style="width: 100%; text-align: center;">View Accounts Report &rarr;</a>
  </div>

  <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">??</div>
      <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem;">Dividends Calculator</h3>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
        Calculate and model surplus dividend payouts pro-rata from member savings & shares contributions.
      </p>
    </div>
    <a href="/dividends" class="btn btn-primary btn-sm" style="width: 100%; text-align: center;">Open Calculator &rarr;</a>
  </div>

  <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">?</div>
      <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem;">Coffee Produce & Factory Rates</h3>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
        Cherry delivery yields (KGs), receipt photo archives, and factory payout rates (KES/KG).
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <a href="/reports/coffee-produce?year=<%= currentYear %>" class="btn btn-primary btn-sm" style="flex: 1; text-align: center;">Coffee Report</a>
      <a href="/coffee/rates" class="btn btn-secondary btn-sm" style="flex: 1; text-align: center;">Factory Rates</a>
    </div>
  </div>

  <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">??</div>
      <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem;">Monthly Contributions</h3>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
        Detailed monthly member breakdown across welfare, savings, shares, and social funds for <%= currentPeriod %>.
      </p>
    </div>
    <a href="/reports/contributions-monthly?period=<%= currentPeriod %>" class="btn btn-primary btn-sm" style="width: 100%; text-align: center;">View Monthly Summary &rarr;</a>
  </div>

  <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">??</div>
      <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem;">Annual 12-Month Matrix</h3>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
        Full-year cross-tab matrix showing monthly deposits and year-to-date totals for every member in <%= currentYear %>.
      </p>
    </div>
    <a href="/reports/contributions-annual?year=<%= currentYear %>" class="btn btn-primary btn-sm" style="width: 100%; text-align: center;">View Annual Matrix &rarr;</a>
  </div>

  <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
    <div>
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">???</div>
      <h3 style="margin: 0 0 0.5rem 0; font-size: 1.15rem;">Commercial Group Projects</h3>
      <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
        Commercial ventures, bulk fertilizer distributions, project revenues, and net margins.
      </p>
    </div>
    <a href="/projects" class="btn btn-primary btn-sm" style="width: 100%; text-align: center;">View Projects &rarr;</a>
  </div>
</div>

<!-- Savings Breakdown Table -->
<div class="card">
  <div class="card-title">Savings & Capital Breakdown by Product</div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Product / Fund</th>
          <th>Category</th>
          <th>Total Transactions</th>
          <th style="text-align: right;">Total Accumulated</th>
        </tr>
      </thead>
      <tbody>
        <% for (const p of savingsByProduct) { %>
          <tr>
            <td><strong><%= p.name %></strong></td>
            <td><span class="badge"><%= p.kind %></span></td>
            <td><%= p.count %></td>
            <td style="text-align: right; color: #34d399; font-weight: 700;"><%= formatMoney(p.totalCents) %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
