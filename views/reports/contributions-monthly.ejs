<%- include('../partials/head.ejs', { title: 'Monthly Contributions Summary - ' + period }) %>
<%- include('../partials/nav.ejs') %>

<div style=display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;>
  <div>
    <h1 style=margin: 0; font-size: 1.75rem;>Monthly Contributions Summary</h1>
    <p style=color: var(--text-muted); margin: 0.25rem 0 0 0;>
      Detailed member breakdown for <strong><%= period %></strong>
    </p>
  </div>

  <div style=display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;>
    <form method=GET action=/reports/contributions-monthly style=margin: 0; display: flex; gap: 0.5rem; align-items: center;>
      <label for=period style=font-size: 0.85rem; color: var(--text-muted);>Period:</label>
      <input type=month id=period name=period value=<%= period %> class=form-control style=width: auto; padding: 0.25rem 0.5rem; font-size: 0.875rem; onchange=this.form.submit()>
    </form>

    <% if (['admin', 'treasurer'].includes(currentUser.role)) { %>
      <a href=/reports/contributions-monthly/export?period=<%= period %> class=btn btn-secondary btn-sm>📥 Export CSV</a>
    <% } %>
    <button onclick=window.print() class=btn btn-secondary btn-sm>🖨️ Print Report</button>
  </div>
</div>

<!-- Category Total Stat Cards -->
<div class=grid grid-4 style=margin-bottom: 1.5rem;>
  <div class=stat-box>
    <div class=stat-label>Total Monthly Collection</div>
    <div class=stat-value style=color: #34d399;><%= formatMoney(report.grandTotalCents) %></div>
  </div>
  <% for (const t of report.types) { %>
    <div class=stat-box>
      <div class=stat-label><%= t.name %></div>
      <div class=stat-value><%= formatMoney(report.typeTotals[t.id] || 0) %></div>
    </div>
  <% } %>
</div>

<!-- Detailed Cross-Tab Table -->
<div class=card>
  <div class=card-title>
    <span>Member Contributions Breakdown (<%= period %>)</span>
    <span style=font-size: 0.85rem; color: var(--text-muted);><%= report.members.length %> Members Listed</span>
  </div>

  <div class=table-responsive>
    <table>
      <thead>
        <tr>
          <th>Member No</th>
          <th>Member Name</th>
          <% for (const t of report.types) { %>
            <th style=text-align: right;><%= t.name %></th>
          <% } %>
          <th style=text-align: right; color: #38bdf8;>Total (KES)</th>
        </tr>
      </thead>
      <tbody>
        <% if (report.members.length === 0) { %>
          <tr>
            <td colspan=<%= report.types.length + 3 %> style=text-align: center; color: var(--text-muted); padding: 2rem;>
              No member records found for this period.
            </td>
          </tr>
        <% } %>

        <% for (const m of report.members) { %>
          <tr>
            <td><strong><%= m.memberNo %></strong></td>
            <td><%= m.fullName %></td>
            <% for (const t of report.types) { %>
              <td style=text-align: right; <%= (m.byType[t.id] || 0) > 0 ? 'font-weight: 500;' : 'color: var(--text-muted);' %>>
                <%= (m.byType[t.id] || 0) > 0 ? formatMoney(m.byType[t.id]) : '-' %>
              </td>
            <% } %>
            <td style=text-align: right; font-weight: 700; color: <%= m.totalCents > 0 ? '#34d399' : 'var(--text-muted)' %>;>
              <%= formatMoney(m.totalCents) %>
            </td>
          </tr>
        <% } %>
      </tbody>
      <% if (report.members.length > 0) { %>
        <tfoot>
          <tr style=border-top: 2px solid var(--border-color); font-weight: 700; background: rgba(255,255,255,0.03);>
            <td colspan=2>TOTALS (ALL MEMBERS)</td>
            <% for (const t of report.types) { %>
              <td style=text-align: right; color: #38bdf8;><%= formatMoney(report.typeTotals[t.id] || 0) %></td>
            <% } %>
            <td style=text-align: right; color: #34d399; font-size: 1.05rem;><%= formatMoney(report.grandTotalCents) %></td>
          </tr>
        </tfoot>
      <% } %>
    </table>
  </div>
</div>

<div class=grid grid-2 style=margin-top: 1.5rem;>
  <div class=card>
    <div class=card-title>Payment Method Channels</div>
    <div style=display: flex; flex-direction: column; gap: 0.75rem;>
      <div style=display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;>
        <span>📱 M-Pesa</span>
        <strong><%= formatMoney(report.paymentMethodTotals.mpesa || 0) %></strong>
      </div>
      <div style=display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;>
        <span>💵 Cash</span>
        <strong><%= formatMoney(report.paymentMethodTotals.cash || 0) %></strong>
      </div>
      <div style=display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;>
        <span>🏦 Bank Transfer</span>
        <strong><%= formatMoney(report.paymentMethodTotals.bank || 0) %></strong>
      </div>
    </div>
  </div>

  <div class=card>
    <div class=card-title>Summary Actions</div>
    <p style=color: var(--text-muted); font-size: 0.9rem;>
      Need full year overview or coffee delivery stats? Explore the other summary reports:
    </p>
    <div style=display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;>
      <a href=/reports/contributions-annual class=btn btn-primary btn-sm>📅 View 12-Month Annual Matrix</a>
      <a href=/reports/coffee-produce class=btn btn-secondary btn-sm>☕ Coffee Produce Yields</a>
    </div>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
