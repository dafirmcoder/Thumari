<%- include('../partials/head.ejs', { title: 'Broadcast Announcement' }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 600px; margin: 1.5rem auto;">
  <div class="card">
    <div class="card-title">
      <span>📢 Broadcast Announcement to All Members</span>
      <a href="/notifications" style="font-size: 0.85rem;">Back to Alerts</a>
    </div>

    <form action="/notifications/broadcast" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="title">Broadcast Title *</label>
        <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Annual General Meeting Notice" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="body">Message Body *</label>
        <textarea id="body" name="body" class="form-control" rows="4" placeholder="Enter the announcement text..." required></textarea>
      </div>

      <div class="form-group">
        <label class="form-label" for="url">Action Link (Optional)</label>
        <input type="text" id="url" name="url" class="form-control" placeholder="e.g. /meetings or /contributions">
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="/notifications" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">🚀 Send Push & In-App Broadcast</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
