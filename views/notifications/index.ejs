<%- include('../partials/head.ejs', { title: 'Notifications & Alerts' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">Notifications & Alerts Center</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">Web Push, SMS / In-App alerts and subscription management</p>
  </div>

  <div style="display: flex; gap: 0.5rem;">
    <% if (currentUser.role === 'admin') { %>
      <a href="/notifications/broadcast" class="btn btn-primary btn-sm">📢 Send Broadcast</a>
    <% } %>
    <form action="/notifications/read-all" method="POST" style="margin: 0;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-secondary btn-sm">Mark All as Read</button>
    </form>
  </div>
</div>

<div class="grid grid-2">
  <!-- Notifications Inbox -->
  <div class="card">
    <div class="card-title">
      <span>Alert Inbox</span>
    </div>

    <% if (notifications.length === 0) { %>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Your inbox is empty. No notifications yet.</p>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <% for (const n of notifications) { %>
          <div style="background: #0f172a; border-left: 4px solid <%= n.readAt ? '#475569' : '#0284c7' %>; padding: 0.85rem; border-radius: 0.375rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <strong style="color: <%= n.readAt ? 'var(--text-muted)' : 'var(--text-main)' %>;"><%= n.title %></strong>
              <small style="color: var(--text-muted);"><%= formatDateTime(n.createdAt) %></small>
            </div>
            <p style="margin: 0 0 0.5rem 0; font-size: 0.9rem; color: var(--text-main);"><%= n.body %></p>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <% if (n.url) { %>
                <a href="<%= n.url %>" style="font-size: 0.8rem;">View Details &rarr;</a>
              <% } else { %>
                <span></span>
              <% } %>
              <% if (!n.readAt) { %>
                <form action="/notifications/<%= n.id %>/read" method="POST" style="margin: 0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary btn-sm" style="padding: 0.15rem 0.45rem; font-size: 0.75rem;">Mark Read</button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Push Subscription & Preferences -->
  <div>
    <!-- Push Device Registration Card -->
    <div class="card">
      <div class="card-title">
        <span>📲 Device Push Status</span>
      </div>

      <p style="font-size: 0.9rem; color: var(--text-muted);">
        Enable browser and Android APK push notifications to receive real-time updates even when the app is closed.
      </p>

      <div style="margin: 1.25rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button type="button" class="btn btn-primary btn-sm" onclick="subscribePushNotifications('<%= vapidPublicKey %>', '<%= csrfToken %>')">
          🔔 Enable Push on This Device
        </button>
        <button type="button" class="btn btn-secondary btn-sm" onclick="sendTestNotification('<%= csrfToken %>')">
          ⚡ Send Test Push
        </button>
      </div>

      <div style="font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
        <strong>Active Subscriptions for your account:</strong> <%= subscriptions.length %> device(s) registered.
      </div>
    </div>

    <!-- Notification Event Preferences Form -->
    <div class="card">
      <div class="card-title">
        <span>Notification Preferences</span>
      </div>

      <form action="/notifications/preferences" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% for (const pref of preferences) { %>
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
              <div>
                <strong><%= pref.label %></strong>
                <div style="font-size: 0.8rem; color: var(--text-muted);"><%= pref.description %></div>
              </div>
              <div>
                <% if (pref.userConfigurable) { %>
                  <input type="checkbox" name="<%= pref.key %>" <%= pref.enabled ? 'checked' : '' %> style="transform: scale(1.25);">
                <% } else { %>
                  <span class="badge" style="background: #334155;">Mandatory</span>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

        <div style="margin-top: 1.25rem; text-align: right;">
          <button type="submit" class="btn btn-primary btn-sm">Save Preferences</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
