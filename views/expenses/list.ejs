<%- include('../partials/head.ejs', { title: 'Expenses Tracking' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">?? Expenses & Operational Costs</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">Track group operating expenses, project expenditures, and receipts</p>
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <% if (['admin', 'treasurer', 'secretary'].includes(currentUser.role)) { %>
      <a href="/expenses/new" class="btn btn-primary btn-sm">+ Record Expense</a>
    <% } %>
    <a href="/reports/accounts" class="btn btn-secondary btn-sm">?? Accounts Report</a>
  </div>
</div>

<!-- Expense Stat Boxes -->
<div class="grid grid-3" style="margin-bottom: 1.5rem;">
  <div class="stat-box">
    <div class="stat-label">Total Expenses (<%= selectedYear %><%= selectedMonth ? '/' + selectedMonth : '' %>)</div>
    <div class="stat-value" style="color: #ef4444;"><%= formatMoney(summary.totalCents) %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Expense Transactions</div>
    <div class="stat-value"><%= records.length %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Expense Categories</div>
    <div class="stat-value" style="color: #38bdf8;"><%= summary.byCategory.length %> Active</div>
  </div>
</div>

<!-- Filters Bar -->
<div class="card" style="margin-bottom: 1.5rem; padding: 1rem;">
  <form method="GET" action="/expenses" style="margin: 0; display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
    <div style="flex: 1; min-width: 180px;">
      <label class="form-label" style="margin-bottom: 0.25rem;">Category</label>
      <select name="category" class="form-control" onchange="this.form.submit()">
        <option value="">-- All Categories --</option>
        <% for (const cat of categories) { %>
          <option value="<%= cat.id %>" <%= selectedCategory === cat.id ? 'selected' : '' %>>
            <%= cat.icon %> <%= cat.name %>
          </option>
        <% } %>
      </select>
    </div>

    <div style="flex: 1; min-width: 180px;">
      <label class="form-label" style="margin-bottom: 0.25rem;">Group Project</label>
      <select name="projectId" class="form-control" onchange="this.form.submit()">
        <option value="">-- All / General Expenses --</option>
        <% for (const p of projectsList) { %>
          <option value="<%= p.project.id %>" <%= selectedProjectId == p.project.id ? 'selected' : '' %>>
            ??? <%= p.project.name %> (<%= p.project.code %>)
          </option>
        <% } %>
      </select>
    </div>

    <div style="width: 120px;">
      <label class="form-label" style="margin-bottom: 0.25rem;">Year</label>
      <input type="number" name="year" class="form-control" value="<%= selectedYear %>" min="2020" max="2035" onchange="this.form.submit()">
    </div>

    <div>
      <a href="/expenses" class="btn btn-secondary btn-sm" style="height: 38px; display: inline-flex; align-items: center;">Reset</a>
    </div>
  </form>
</div>

<!-- Expenses Table -->
<div class="card">
  <div class="card-title">
    <span>Expense Records (<%= records.length %>)</span>
    <% if (['admin', 'treasurer', 'secretary'].includes(currentUser.role)) { %>
      <a href="/expenses/new" style="font-size: 0.85rem;">+ Record Expense</a>
    <% } %>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Category</th>
          <th>Payee / Vendor</th>
          <th>Purpose & Notes</th>
          <th>Project</th>
          <th>Payment</th>
          <th style="text-align: right;">Amount (KES)</th>
          <th style="text-align: center;">Receipt Photo</th>
          <% if (['admin', 'treasurer'].includes(currentUser.role)) { %>
            <th style="text-align: center;">Action</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% if (records.length === 0) { %>
          <tr>
            <td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
              No expenses found matching the selected filters.
              <br><br>
              <% if (['admin', 'treasurer', 'secretary'].includes(currentUser.role)) { %>
                <a href="/expenses/new" class="btn btn-primary btn-sm">+ Record First Expense</a>
              <% } %>
            </td>
          </tr>
        <% } %>

        <% for (const r of records) { %>
          <tr>
            <td><%= formatDate(r.expense.expenseDate) %></td>
            <td>
              <% const matchedCat = categories.find(c => c.id === r.expense.category); %>
              <span class="badge" style="background: #334155;">
                <%= matchedCat ? matchedCat.icon + ' ' + matchedCat.name : r.expense.category %>
              </span>
            </td>
            <td><strong><%= r.expense.payee %></strong></td>
            <td>
              <div><%= r.expense.purpose %></div>
              <% if (r.expense.receiptNumber) { %>
                <span style="font-size: 0.75rem; color: var(--text-muted);">Ref: <%= r.expense.receiptNumber %></span>
              <% } %>
            </td>
            <td>
              <% if (r.project) { %>
                <a href="/projects/<%= r.project.id %>" class="badge" style="background: #0284c7;">
                  ??? <%= r.project.name %>
                </a>
              <% } else { %>
                <span style="color: var(--text-muted); font-size: 0.8rem;">General Operations</span>
              <% } %>
            </td>
            <td>
              <span style="text-transform: uppercase; font-size: 0.8rem; font-weight: 600;"><%= r.expense.paymentMethod %></span>
            </td>
            <td style="text-align: right; color: #ef4444; font-weight: 700;">
              <%= formatMoney(r.expense.amountCents) %>
            </td>
            <td style="text-align: center;">
              <% if (r.expense.receiptPhotoUrl) { %>
                <button type="button" 
                        onclick="openReceiptModal('<%= r.expense.receiptPhotoUrl %>', '<%= r.expense.payee %>', '<%= formatMoney(r.expense.amountCents) %>', '<%= formatDate(r.expense.expenseDate) %>')"
                        class="btn btn-secondary btn-sm"
                        style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">
                  ??? View Receipt
                </button>
              <% } else { %>
                <span style="color: var(--text-muted); font-size: 0.8rem;">No receipt</span>
              <% } %>
            </td>
            <% if (['admin', 'treasurer'].includes(currentUser.role)) { %>
              <td style="text-align: center;">
                <form action="/expenses/<%= r.expense.id %>/delete" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Delete this expense record?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary btn-sm" style="color: #ef4444; padding: 0.2rem 0.4rem; font-size: 0.75rem;">???</button>
                </form>
              </td>
            <% } %>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Receipt Modal -->
<div id="expenseReceiptModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 9999; justify-content: center; align-items: center; padding: 1rem; backdrop-filter: blur(4px);">
  <div style="background: var(--bg-card, #1e293b); border: 1px solid var(--border-color, #334155); border-radius: 0.75rem; max-width: 700px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden;">
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border-color, #334155);">
      <div>
        <h3 id="modalPayee" style="margin: 0; font-size: 1.1rem; color: #f8fafc;">Expense Receipt</h3>
        <p id="modalSub" style="margin: 0.2rem 0 0 0; font-size: 0.8rem; color: var(--text-muted);"></p>
      </div>
      <button type="button" onclick="closeReceiptModal()" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 1.1rem;">?</button>
    </div>
    <div style="padding: 1rem; text-align: center; background: #0b0f19; overflow-y: auto;">
      <img id="modalImg" src="" alt="Expense Receipt" style="max-width: 100%; max-height: 65vh; object-fit: contain; border-radius: 0.375rem;">
    </div>
  </div>
</div>

<script>
  function openReceiptModal(src, payee, amount, date) {
    document.getElementById('modalImg').src = src;
    document.getElementById('modalPayee').innerText = '?? Receipt: ' + payee;
    document.getElementById('modalSub').innerText = 'Amount: ' + amount + ' • Date: ' + date;
    document.getElementById('expenseReceiptModal').style.display = 'flex';
  }
  function closeReceiptModal() {
    document.getElementById('expenseReceiptModal').style.display = 'none';
  }
  document.getElementById('expenseReceiptModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeReceiptModal();
  });
</script>

<%- include('../partials/foot.ejs') %>
