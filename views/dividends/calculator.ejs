<%- include('../partials/head.ejs', { title: 'Dividends Calculator' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">?? Dividends & Surplus Distribution Calculator</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">
      Calculate annual member dividend payouts pro-rata from cumulative savings & shares contributions
    </p>
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/dividends/export?profitPool=<%= profitPoolCents / 100 %>&retainedPct=<%= retainedEarningsPercent %>&whtPct=<%= withholdingTaxPercent %>&year=<%= year %>&basis=<%= distributionBasis %>" class="btn btn-primary btn-sm">?? Export CSV</a>
    <button onclick="window.print()" class="btn btn-secondary btn-sm">??? Print Statement</button>
  </div>
</div>

<!-- Calculator Control Panel Card -->
<div class="card" style="margin-bottom: 1.5rem; padding: 1.25rem; background: var(--bg-card);">
  <div class="card-title" style="margin-bottom: 1rem;">
    <span>?? Dividend Calculation Parameters</span>
  </div>

  <form method="GET" action="/dividends" style="margin: 0;">
    <div class="grid grid-4" style="gap: 1rem; align-items: flex-end;">
      <div>
        <label class="form-label" style="margin-bottom: 0.25rem;">Total Profit / Dividend Pool (KES) *</label>
        <input type="number" name="profitPool" class="form-control" value="<%= (profitPoolCents / 100).toFixed(0) %>" step="1000" min="1000" required>
      </div>

      <div>
        <label class="form-label" style="margin-bottom: 0.25rem;">Retained Reserves (%)</label>
        <input type="number" name="retainedPct" class="form-control" value="<%= retainedEarningsPercent %>" step="0.5" min="0" max="100">
      </div>

      <div>
        <label class="form-label" style="margin-bottom: 0.25rem;">Withholding Tax (%)</label>
        <input type="number" name="whtPct" class="form-control" value="<%= withholdingTaxPercent %>" step="0.5" min="0" max="30">
      </div>

      <div>
        <label class="form-label" style="margin-bottom: 0.25rem;">Year</label>
        <div style="display: flex; gap: 0.5rem;">
          <input type="number" name="year" class="form-control" value="<%= year %>" min="2020" max="2035">
          <button type="submit" class="btn btn-primary btn-sm" style="height: 38px; padding: 0 1rem;">Calculate</button>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Summary Stat Cards -->
<div class="grid grid-4" style="margin-bottom: 1.5rem;">
  <div class="stat-box">
    <div class="stat-label">Total Profit Pool</div>
    <div class="stat-value"><%= formatMoney(result.totalProfitPoolCents) %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Retained Reserves (<%= result.retainedEarningsPercent %>%)</div>
    <div class="stat-value" style="color: #f59e0b;"><%= formatMoney(result.retainedReservesCents) %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Distributable Dividends</div>
    <div class="stat-value" style="color: #38bdf8;"><%= formatMoney(result.distributableDividendCents) %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Net Payable to Members</div>
    <div class="stat-value" style="color: #34d399;"><%= formatMoney(result.totalNetPayableCents) %></div>
  </div>
</div>

<!-- Member Allocation Table -->
<div class="card">
  <div class="card-title">
    <span>Member Dividend Distribution Schedule (<%= result.memberAllocations.length %> Members)</span>
    <span style="font-size: 0.85rem; color: var(--text-muted);">
      Total Member Contributions Capital: <strong><%= formatMoney(result.totalQualifyingContributionsCents) %></strong>
    </span>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Member No</th>
          <th>Farmer / Member Name</th>
          <th>Phone</th>
          <th style="text-align: right;">Cumulative Savings (KES)</th>
          <th style="text-align: right;">Capital Share</th>
          <th style="text-align: right;">Gross Dividend (KES)</th>
          <th style="text-align: right; color: #ef4444;">WHT (<%= result.withholdingTaxPercent %>%)</th>
          <th style="text-align: right; color: #34d399; font-weight: 700;">Net Dividend (KES)</th>
        </tr>
      </thead>
      <tbody>
        <% if (result.memberAllocations.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
              No active members found to calculate dividends for.
            </td>
          </tr>
        <% } %>

        <% for (const m of result.memberAllocations) { %>
          <tr>
            <td><strong><%= m.memberNo %></strong></td>
            <td>
              <a href="/members/<%= m.memberId %>"><strong><%= m.fullName %></strong></a>
            </td>
            <td><%= m.phone || '—' %></td>
            <td style="text-align: right; font-weight: 600;">
              <%= formatMoney(m.cumulativeContributionsCents) %>
            </td>
            <td style="text-align: right; color: #38bdf8; font-weight: 600;">
              <%= m.contributionSharePercent.toFixed(2) %>%
            </td>
            <td style="text-align: right;">
              <%= formatMoney(m.grossDividendCents) %>
            </td>
            <td style="text-align: right; color: #ef4444;">
              <%= formatMoney(m.withholdingTaxCents) %>
            </td>
            <td style="text-align: right; color: #34d399; font-weight: 700; font-size: 1.05rem;">
              <%= formatMoney(m.netDividendPayableCents) %>
            </td>
          </tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr style="background: rgba(15,23,42,0.6); font-weight: 700;">
          <td colspan="3">TOTALS (<%= result.memberAllocations.length %> Members)</td>
          <td style="text-align: right;"><%= formatMoney(result.totalQualifyingContributionsCents) %></td>
          <td style="text-align: right; color: #38bdf8;">100.00%</td>
          <td style="text-align: right;"><%= formatMoney(result.distributableDividendCents) %></td>
          <td style="text-align: right; color: #ef4444;"><%= formatMoney(result.totalWithholdingTaxCents) %></td>
          <td style="text-align: right; color: #34d399; font-size: 1.1rem;"><%= formatMoney(result.totalNetPayableCents) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
