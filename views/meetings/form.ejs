<%- include('../partials/head.ejs', { title: 'Schedule Meeting' }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 600px; margin: 1.5rem auto;">
  <div class="card">
    <div class="card-title">
      <span>Schedule Group Meeting</span>
      <a href="/meetings" style="font-size: 0.85rem;">Back to Meetings</a>
    </div>

    <form action="/meetings" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="title">Meeting Title *</label>
        <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Monthly Chama General Meeting" required>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="scheduledAt">Date & Time *</label>
          <input type="datetime-local" id="scheduledAt" name="scheduledAt" class="form-control" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="absenceFine">Absence Fine (<%= org.currencySymbol %>)</label>
          <input type="text" id="absenceFine" name="absenceFine" class="form-control" placeholder="5,000" value="5,000">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="location">Location / Venue / Virtual Link</label>
        <input type="text" id="location" name="location" class="form-control" placeholder="e.g. Community Hall or Google Meet">
      </div>

      <div class="form-group">
        <label class="form-label" for="agenda">Agenda & Objectives</label>
        <textarea id="agenda" name="agenda" class="form-control" rows="4" placeholder="1. Welcome remarks&#10;2. Contributions review&#10;3. Loan disbursements&#10;4. AOB"></textarea>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="/meetings" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Schedule & Broadcast Alert</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
