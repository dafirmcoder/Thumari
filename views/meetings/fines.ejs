<%- include('../partials/head.ejs', { title: 'Fines Ledger' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">Fines & Penalties Ledger</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">Meeting absence penalties and group discipline fines</p>
  </div>

  <a href="/meetings" class="btn btn-secondary btn-sm">Back to Meetings</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Issued Date</th>
          <th>Member</th>
          <th>Reason</th>
          <th>Amount</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (fines.length === 0) { %>
          <tr>
            <td colspan="5" style="text-align: center; color: var(--text-muted);">No fines recorded.</td>
          </tr>
        <% } %>
        <% for (const f of fines) { %>
          <tr>
            <td><%= formatDate(f.issuedAt) %></td>
            <td><strong><%= f.memberName %></strong> (<%= f.memberNo %>)</td>
            <td><%= f.reason %></td>
            <td style="color: #f87171; font-weight: 700;"><%= formatMoney(f.amountCents) %></td>
            <td>
              <span class="badge" style="background: <%= f.status === 'paid' ? '#10b981' : '#ef4444' %>;">
                <%= f.status.toUpperCase() %>
              </span>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
