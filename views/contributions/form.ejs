<%- include('../partials/head.ejs', { title: 'Record Contribution' }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 600px; margin: 1.5rem auto;">
  <div class="card">
    <div class="card-title">
      <span>Record Member Contribution</span>
      <a href="/contributions" style="font-size: 0.85rem;">Back to Ledger</a>
    </div>

    <form action="/contributions" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="memberId">Select Member *</label>
        <select id="memberId" name="memberId" class="form-control" required>
          <option value="">-- Choose Member --</option>
          <% for (const m of members) { %>
            <option value="<%= m.id %>"><%= m.memberNo %> &mdash; <%= m.firstName %> <%= m.lastName %></option>
          <% } %>
        </select>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="typeId">Contribution Type *</label>
          <select id="typeId" name="typeId" class="form-control" required>
            <% for (const t of types) { %>
              <option value="<%= t.id %>"><%= t.name %> (<%= t.kind %>)</option>
            <% } %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="amount">Amount (<%= org.currencySymbol %>) *</label>
          <input type="text" id="amount" name="amount" class="form-control" placeholder="50,000" required>
        </div>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="paidAt">Payment Date *</label>
          <input type="date" id="paidAt" name="paidAt" class="form-control" value="<%= toDateInput(new Date()) %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="method">Payment Method</label>
          <select id="method" name="method" class="form-control">
            <option value="mpesa">M-Pesa</option>
            <option value="cash">Cash</option>
            <option value="bank">Bank Transfer</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="reference">Transaction Reference / Receipt No</label>
        <input type="text" id="reference" name="reference" class="form-control" placeholder="e.g. QKH789234">
      </div>

      <div class="form-group">
        <label class="form-label" for="notes">Notes</label>
        <textarea id="notes" name="notes" class="form-control" rows="2"></textarea>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="/contributions" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save & Issue Receipt</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
