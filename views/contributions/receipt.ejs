<%- include('../partials/head.ejs', { title: 'Contribution Receipt' }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 540px; margin: 2rem auto;">
  <div class="card" style="border: 2px solid var(--primary); background: #1e293b;">
    <div style="text-align: center; border-bottom: 1px dashed var(--border-color); padding-bottom: 1.25rem; margin-bottom: 1.25rem;">
      <h2 style="margin: 0; color: #38bdf8;"><%= org.name %></h2>
      <div style="font-size: 0.85rem; color: var(--text-muted);"><%= org.tagline %></div>
      <div style="display: inline-block; background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 9999px; margin-top: 0.75rem; font-size: 0.85rem;">
        OFFICIAL RECEIPT
      </div>
    </div>

    <div class="grid grid-2" style="font-size: 0.95rem; margin-bottom: 1rem;">
      <div>
        <div style="color: var(--text-muted); font-size: 0.8rem;">RECEIPT NO:</div>
        <strong>REC-<%= receipt.contribution.id.toString().padStart(5, '0') %></strong>
      </div>
      <div style="text-align: right;">
        <div style="color: var(--text-muted); font-size: 0.8rem;">DATE:</div>
        <strong><%= formatDate(receipt.contribution.paidAt) %></strong>
      </div>
    </div>

    <div style="background: #0f172a; padding: 1rem; border-radius: 0.5rem; margin-bottom: 1.25rem;">
      <div style="font-size: 0.8rem; color: var(--text-muted);">RECEIVED FROM:</div>
      <div style="font-size: 1.1rem; font-weight: 700;"><%= receipt.member.firstName %> <%= receipt.member.lastName %></div>
      <div style="font-size: 0.85rem; color: var(--text-muted);">Member No: <%= receipt.member.memberNo %></div>
    </div>

    <div style="margin-bottom: 1.25rem;">
      <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding: 0.5rem 0;">
        <span style="color: var(--text-muted);">Contribution Type:</span>
        <strong><%= receipt.type.name %> (<%= receipt.type.kind %>)</strong>
      </div>
      <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding: 0.5rem 0;">
        <span style="color: var(--text-muted);">Payment Method:</span>
        <strong><%= receipt.contribution.method.toUpperCase() %></strong>
      </div>
      <% if (receipt.contribution.reference) { %>
        <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding: 0.5rem 0;">
          <span style="color: var(--text-muted);">Reference:</span>
          <code><%= receipt.contribution.reference %></code>
        </div>
      <% } %>
      <div style="display: flex; justify-content: space-between; padding: 0.75rem 0; font-size: 1.2rem;">
        <strong>Total Paid:</strong>
        <strong style="color: #34d399;"><%= formatMoney(receipt.contribution.amountCents) %></strong>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
      <a href="/contributions" class="btn btn-secondary">Back to Ledger</a>
      <button onclick="window.print()" class="btn btn-primary">🖨️ Print Receipt</button>
    </div>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
