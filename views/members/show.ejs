<%- include('../partials/head.ejs', { title: member.firstName + ' ' + member.lastName }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <div style="font-size: 0.85rem; color: var(--text-muted);"><%= member.memberNo %> &bull; Joined <%= formatDate(member.joinDate) %></div>
    <h1 style="margin: 0; font-size: 1.75rem;"><%= member.firstName %> <%= member.lastName %></h1>
  </div>

  <div>
    <span class="badge" style="font-size: 1rem; padding: 0.35rem 0.75rem; background: <%= member.status === 'active' ? '#10b981' : '#f59e0b' %>;">
      <%= member.status.toUpperCase() %>
    </span>
  </div>
</div>

<div class="grid grid-3" style="margin-bottom: 1.5rem;">
  <div class="stat-box">
    <div class="stat-label">Phone</div>
    <div class="stat-value" style="font-size: 1.1rem; color: var(--text-main);"><%= member.phone || '—' %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Email</div>
    <div class="stat-value" style="font-size: 1.1rem; color: var(--text-main);"><%= member.email || '—' %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">National ID</div>
    <div class="stat-value" style="font-size: 1.1rem; color: var(--text-main);"><%= member.nationalId || '—' %></div>
  </div>
</div>

<div class="grid grid-2">
  <!-- Member Contributions -->
  <div class="card">
    <div class="card-title">
      <span>Contributions History</span>
    </div>

    <% if (contributions.length === 0) { %>
      <p style="color: var(--text-muted); font-size: 0.9rem;">No contributions recorded for this member.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Type</th>
              <th>Amount</th>
              <th>Period</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% for (const c of contributions) { %>
              <tr>
                <td><%= c.typeName %></td>
                <td style="color: #34d399; font-weight: 600;"><%= formatMoney(c.amountCents) %></td>
                <td><%= c.period || '—' %></td>
                <td><%= formatDate(c.paidAt) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Member Loans -->
  <div class="card">
    <div class="card-title">
      <span>Loans</span>
    </div>

    <% if (loans.length === 0) { %>
      <p style="color: var(--text-muted); font-size: 0.9rem;">No loans associated with this member.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Loan No</th>
              <th>Principal</th>
              <th>Outstanding</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% for (const l of loans) { %>
              <tr>
                <td><a href="/loans/<%= l.id %>"><strong><%= l.loanNo %></strong></a></td>
                <td><%= formatMoney(l.principalCents) %></td>
                <td><%= formatMoney(l.outstandingCents) %></td>
                <td>
                  <span class="badge" style="background: <%= l.status === 'disbursed' ? '#10b981' : '#64748b' %>;">
                    <%= l.status %>
                  </span>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
