<%- include('../partials/head.ejs', { title: 'Members' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">?? Group Members</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">Registered Thumari Men''s Association Members & Farmers</p>
  </div>

  <% if (['admin', 'secretary'].includes(currentUser.role)) { %>
    <a href="/members/new" class="btn btn-primary btn-sm">+ Register Member</a>
  <% } %>
</div>

<div class="card">
  <form method="GET" action="/members" style="display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
    <input type="text" name="search" class="form-control" placeholder="Search by name, member number, phone, or National ID..." value="<%= search || '' %>" style="max-width: 420px; flex: 1; min-width: 240px;">
    <select name="status" class="form-control" style="max-width: 180px;">
      <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Statuses</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="dormant" <%= status === 'dormant' ? 'selected' : '' %>>Dormant</option>
      <option value="exited" <%= status === 'exited' ? 'selected' : '' %>>Exited</option>
    </select>
    <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
  </form>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Member No</th>
          <th>Farmer / Member Name</th>
          <th>National ID</th>
          <th>Phone</th>
          <th>Status</th>
          <th style="text-align: right;">Savings (KES)</th>
          <th>Joined</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (members.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">No members found matching your search.</td>
          </tr>
        <% } %>
        <% for (const m of members) { %>
          <tr>
            <td><strong><%= m.memberNo %></strong></td>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; background: #0284c7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--border-color);">
                  <% if (m.photoUrl) { %>
                    <img src="<%= m.photoUrl %>" alt="<%= m.firstName %>" style="width: 100%; height: 100%; object-fit: cover;">
                  <% } else { %>
                    <span style="font-size: 0.85rem; color: #fff; font-weight: 700;">
                      <%= m.firstName[0] %><%= m.lastName[0] %>
                    </span>
                  <% } %>
                </div>
                <div>
                  <a href="/members/<%= m.id %>"><strong><%= m.firstName %> <%= m.lastName %></strong></a>
                </div>
              </div>
            </td>
            <td>
              <% if (m.nationalId) { %>
                <span style="font-family: monospace; font-size: 0.9rem; color: #38bdf8;">?? <%= m.nationalId %></span>
              <% } else { %>
                <span style="color: var(--text-muted); font-size: 0.85rem;">—</span>
              <% } %>
            </td>
            <td><%= m.phone || '—' %></td>
            <td>
              <span class="badge" style="background: <%= m.status === 'active' ? '#10b981' : '#f59e0b' %>;">
                <%= m.status %>
              </span>
            </td>
            <td style="text-align: right; color: #34d399; font-weight: 600;"><%= formatMoney(m.totalSavingsCents) %></td>
            <td><%= formatDate(m.joinDate) %></td>
            <td>
              <div style="display: flex; gap: 0.35rem;">
                <a href="/members/<%= m.id %>" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">Profile</a>
                <% if (['admin', 'secretary'].includes(currentUser.role)) { %>
                  <a href="/members/<%= m.id %>/edit" class="btn btn-secondary btn-sm" style="padding: 0.2rem 0.5rem; font-size: 0.8rem;">Edit</a>
                <% } %>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
