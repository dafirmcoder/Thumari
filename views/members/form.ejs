<%- include('../partials/head.ejs', { title: (member ? 'Edit Member - ' + member.firstName + ' ' + member.lastName : 'Register Member') }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 680px; margin: 1.5rem auto;">
  <div class="card">
    <div class="card-title">
      <span><%= member ? '?? Edit Member Profile' : '?? Register New Member' %></span>
      <a href="<%= member ? '/members/' + member.id : '/members' %>" style="font-size: 0.85rem;">&larr; Back</a>
    </div>

    <form action="<%= member ? '/members/' + member.id : '/members' %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Member Photo Section -->
      <div style="display: flex; gap: 1.5rem; align-items: center; margin-bottom: 1.5rem; padding: 1rem; background: var(--bg-card-header, rgba(15,23,42,0.4)); border-radius: 0.5rem; border: 1px dashed var(--border-color);">
        <div style="position: relative; width: 80px; height: 80px; border-radius: 50%; overflow: hidden; background: #0284c7; display: flex; align-items: center; justify-content: center; border: 2px solid var(--border-color); flex-shrink: 0;">
          <img id="photoPreviewImg" 
               src="<%= member && member.photoUrl ? member.photoUrl : '' %>" 
               alt="Member Photo" 
               style="width: 100%; height: 100%; object-fit: cover; display: <%= member && member.photoUrl ? 'block' : 'none' %>;">
          <span id="photoPreviewPlaceholder" style="font-size: 2rem; color: #fff; display: <%= member && member.photoUrl ? 'none' : 'block' %>;">??</span>
        </div>

        <div style="flex: 1;">
          <label class="form-label" style="margin-bottom: 0.25rem;">Member Passport Photo / Selfie</label>
          <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 0.5rem 0;">Take a photo with phone camera or upload portrait image (JPG/PNG)</p>
          <input type="file" id="memberPhotoInput" name="photo" accept="image/*" capture="user" class="form-control" style="font-size: 0.85rem; padding: 0.35rem;" onchange="previewMemberPhoto(this)">
        </div>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="firstName">First Name *</label>
          <input type="text" id="firstName" name="firstName" class="form-control" required value="<%= member ? member.firstName : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="lastName">Last Name *</label>
          <input type="text" id="lastName" name="lastName" class="form-control" required value="<%= member ? member.lastName : '' %>">
        </div>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="nationalId">National ID Number *</label>
          <input type="text" id="nationalId" name="nationalId" class="form-control" placeholder="e.g. 23456789" value="<%= member ? (member.nationalId || '') : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="phone">Phone Number (M-Pesa)</label>
          <input type="tel" id="phone" name="phone" class="form-control" placeholder="+254 712 345 678" value="<%= member ? (member.phone || '') : '' %>">
        </div>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input type="email" id="email" name="email" class="form-control" placeholder="member@gmail.com" value="<%= member ? (member.email || '') : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label" for="joinDate">Join Date</label>
          <input type="date" id="joinDate" name="joinDate" class="form-control" value="<%= member ? toDateInput(member.joinDate) : toDateInput(new Date()) %>">
        </div>
      </div>

      <% if (member) { %>
        <div class="form-group">
          <label class="form-label" for="status">Membership Status</label>
          <select id="status" name="status" class="form-control">
            <option value="active" <%= member.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="dormant" <%= member.status === 'dormant' ? 'selected' : '' %>>Dormant</option>
            <option value="exited" <%= member.status === 'exited' ? 'selected' : '' %>>Exited</option>
          </select>
        </div>
      <% } %>

      <div class="form-group">
        <label class="form-label" for="notes">Notes / Farm Details / Location</label>
        <textarea id="notes" name="notes" class="form-control" rows="3" placeholder="e.g. Farm in Kutus, Kii Factory Grower #1402..."><%= member ? (member.notes || '') : '' %></textarea>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="<%= member ? '/members/' + member.id : '/members' %>" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><%= member ? 'Update Profile' : 'Save & Register Member' %></button>
      </div>
    </form>
  </div>
</div>

<script>
  function previewMemberPhoto(input) {
    if (input.files && input.files[0]) {
      var reader = new FileReader();
      reader.onload = function(e) {
        var img = document.getElementById('photoPreviewImg');
        var placeholder = document.getElementById('photoPreviewPlaceholder');
        img.src = e.target.result;
        img.style.display = 'block';
        placeholder.style.display = 'none';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

<%- include('../partials/foot.ejs') %>
