<%- include('../partials/head.ejs', { title: fin.project.name }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <div style="font-size: 0.85rem; color: #38bdf8; font-weight: 700;"><%= fin.project.code %></div>
    <h1 style="margin: 0; font-size: 1.75rem;"><%= fin.project.name %></h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;"><%= fin.project.description || 'Commercial Group Initiative' %></p>
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <% if (['admin', 'treasurer', 'secretary'].includes(currentUser.role)) { %>
      <a href="/projects/<%= fin.project.id %>/income/new" class="btn btn-primary btn-sm">+ Record Income</a>
      <a href="/expenses/new" class="btn btn-secondary btn-sm">+ Record Expense</a>
    <% } %>
    <a href="/projects" class="btn btn-secondary btn-sm">&larr; All Projects</a>
  </div>
</div>

<!-- Project P&L Summary Cards -->
<div class="grid grid-3" style="margin-bottom: 1.5rem;">
  <div class="stat-box">
    <div class="stat-label">Total Incomes / Sales</div>
    <div class="stat-value" style="color: #34d399;"><%= formatMoney(fin.totalIncomeCents) %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Direct Project Expenses</div>
    <div class="stat-value" style="color: #ef4444;"><%= formatMoney(fin.totalExpenseCents) %></div>
  </div>
  <div class="stat-box">
    <div class="stat-label">Net Project Profit / Margin</div>
    <div class="stat-value" style="color: <%= fin.netProfitCents >= 0 ? '#38bdf8' : '#ef4444' %>;">
      <%= formatMoney(fin.netProfitCents) %>
    </div>
  </div>
</div>

<div class="grid grid-2" style="gap: 1.5rem;">
  <!-- Incomes List -->
  <div class="card">
    <div class="card-title">
      <span>?? Project Revenue Inflows (<%= incomes.length %>)</span>
      <% if (['admin', 'treasurer', 'secretary'].includes(currentUser.role)) { %>
        <a href="/projects/<%= fin.project.id %>/income/new" style="font-size: 0.85rem;">+ Add</a>
      <% } %>
    </div>

    <% if (incomes.length === 0) { %>
      <p style="color: var(--text-muted); padding: 1.5rem 0; text-align: center;">No revenue recorded yet for this project.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Source / Particulars</th>
              <th>Ref</th>
              <th style="text-align: right;">Amount (KES)</th>
            </tr>
          </thead>
          <tbody>
            <% for (const inc of incomes) { %>
              <tr>
                <td><%= formatDate(inc.income.incomeDate) %></td>
                <td><strong><%= inc.income.source %></strong></td>
                <td><span style="font-size: 0.8rem; font-family: monospace;"><%= inc.income.receiptNo || inc.income.paymentMethod %></span></td>
                <td style="text-align: right; color: #34d399; font-weight: 600;"><%= formatMoney(inc.income.amountCents) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Direct Expenses List -->
  <div class="card">
    <div class="card-title">
      <span>?? Direct Project Expenditures (<%= directExpenses.length %>)</span>
      <% if (['admin', 'treasurer', 'secretary'].includes(currentUser.role)) { %>
        <a href="/expenses/new" style="font-size: 0.85rem;">+ Add</a>
      <% } %>
    </div>

    <% if (directExpenses.length === 0) { %>
      <p style="color: var(--text-muted); padding: 1.5rem 0; text-align: center;">No direct expenses allocated to this project.</p>
    <% } else { %>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Payee & Purpose</th>
              <th style="text-align: right;">Amount (KES)</th>
            </tr>
          </thead>
          <tbody>
            <% for (const exp of directExpenses) { %>
              <tr>
                <td><%= formatDate(exp.expense.expenseDate) %></td>
                <td>
                  <strong><%= exp.expense.payee %></strong>
                  <div style="font-size: 0.8rem; color: var(--text-muted);"><%= exp.expense.purpose %></div>
                </td>
                <td style="text-align: right; color: #ef4444; font-weight: 600;"><%= formatMoney(exp.expense.amountCents) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
