<%- include('../partials/head.ejs', { title: 'Coffee Factory Rates per KG' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">?? Coffee Factory Rates per KG</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">
      Configure seasonal payout rates (KES/KG) per factory & grade (e.g. Kii Factory: Cherry @ KES 115/KG, Mbuni @ KES 130/KG)
    </p>
  </div>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    <a href="/coffee/scan" class="btn btn-primary btn-sm">?? Scan Receipt</a>
    <a href="/coffee" class="btn btn-secondary btn-sm">?? Deliveries</a>
    <a href="/reports/coffee-produce" class="btn btn-secondary btn-sm">?? Coffee Report</a>
  </div>
</div>

<div class="grid grid-2" style="align-items: start; gap: 1.5rem;">
  <!-- Set / Update Rate Form -->
  <div class="card">
    <div class="card-title">
      <span>? Set / Update Factory Rate</span>
    </div>

    <form action="/coffee/rates" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="factoryName">Coffee Factory Name *</label>
        <input type="text" id="factoryName" name="factoryName" class="form-control" placeholder="e.g. Kii Factory, Karimikui, Kiangoi..." required list="factorySuggestions">
        <datalist id="factorySuggestions">
          <option value="Kii Factory">
          <option value="Karimikui Factory">
          <option value="Kiangoi Factory">
          <option value="Thunguri Factory">
          <option value="Mutira Factory">
          <option value="Kibugu Factory">
        </datalist>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="societyName">Cooperative Society</label>
          <input type="text" id="societyName" name="societyName" class="form-control" placeholder="e.g. Rung''eto FCS, Mutira FCS">
        </div>

        <div class="form-group">
          <label class="form-label" for="seasonYear">Season Year *</label>
          <input type="number" id="seasonYear" name="seasonYear" class="form-control" value="<%= selectedYear %>" min="2020" max="2035" required>
        </div>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="grade">Coffee Grade / Type *</label>
          <select id="grade" name="grade" class="form-control" required>
            <option value="Cherry" selected>Main Cherry (Grade 1)</option>
            <option value="Mbuni">Mbuni (Dry Cherry)</option>
            <option value="Grade 2">Grade 2</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="ratePerKg">Rate per KG (KES) *</label>
          <input type="number" id="ratePerKg" name="ratePerKg" class="form-control" placeholder="e.g. 115.00" step="0.50" min="1" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="notes">Notes / Circular Reference</label>
        <textarea id="notes" name="notes" class="form-control" rows="2" placeholder="e.g. Society season advance rate or final payout rate..."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
        <button type="submit" class="btn btn-primary">Save Factory Rate</button>
      </div>
    </form>
  </div>

  <!-- Active Rates Table -->
  <div class="card">
    <div class="card-title">
      <span>Configured Factory Rates (<%= selectedYear %>)</span>
      <form method="GET" action="/coffee/rates" style="margin: 0; display: inline-flex; gap: 0.5rem; align-items: center;">
        <input type="number" name="year" value="<%= selectedYear %>" class="form-control" style="width: 90px; padding: 0.2rem 0.4rem; font-size: 0.85rem;" onchange="this.form.submit()">
      </form>
    </div>

    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Factory</th>
            <th>Grade</th>
            <th style="text-align: right;">Rate / KG (KES)</th>
            <th style="text-align: center;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (rates.length === 0) { %>
            <tr>
              <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 2rem;">
                No factory rates configured for <%= selectedYear %>.
                <br><br>
                Fill in the form to register rates for Kii, Karimikui, or your local factories.
              </td>
            </tr>
          <% } %>

          <% for (const r of rates) { %>
            <tr>
              <td>
                <strong><%= r.factoryName %></strong>
                <% if (r.societyName) { %>
                  <div style="font-size: 0.75rem; color: var(--text-muted);"><%= r.societyName %></div>
                <% } %>
              </td>
              <td>
                <span class="badge" style="background: <%= r.grade === 'Mbuni' ? '#854d0e' : '#0284c7' %>;">
                  <%= r.grade %>
                </span>
              </td>
              <td style="text-align: right; font-weight: 700; color: #34d399; font-size: 1.1rem;">
                KES <%= (r.ratePerKgCents / 100).toFixed(2) %>
              </td>
              <td style="text-align: center;">
                <form action="/coffee/rates/<%= r.id %>/delete" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('Delete rate for <%= r.factoryName %>?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary btn-sm" style="color: #ef4444; padding: 0.2rem 0.4rem; font-size: 0.75rem;">???</button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
