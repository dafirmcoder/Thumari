<%- include('../partials/head.ejs', { title: 'Loans' }) %>
<%- include('../partials/nav.ejs') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
  <div>
    <h1 style="margin: 0; font-size: 1.75rem;">Loans Management</h1>
    <p style="color: var(--text-muted); margin: 0.25rem 0 0 0;">Applications, Amortized Schedules & Repayments</p>
  </div>

  <a href="/loans/new" class="btn btn-primary btn-sm">+ Apply for Loan</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Loan No</th>
          <th>Member</th>
          <th>Product</th>
          <th>Principal</th>
          <th>Term</th>
          <th>Outstanding</th>
          <th>Status</th>
          <th>Applied Date</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (loans.length === 0) { %>
          <tr>
            <td colspan="9" style="text-align: center; color: var(--text-muted);">No loans found.</td>
          </tr>
        <% } %>
        <% for (const l of loans) { %>
          <tr>
            <td><strong><%= l.loanNo %></strong></td>
            <td><%= l.memberName %></td>
            <td><%= l.productName %></td>
            <td><%= formatMoney(l.principalCents) %></td>
            <td><%= l.termMonths %> mos</td>
            <td style="color: <%= l.outstandingCents > 0 ? '#38bdf8' : '#34d399' %>; font-weight: 600;">
              <%= formatMoney(l.outstandingCents) %>
            </td>
            <td>
              <span class="badge" style="background: <%= l.status === 'disbursed' ? '#10b981' : l.status === 'approved' ? '#0284c7' : l.status === 'pending' ? '#f59e0b' : '#64748b' %>;">
                <%= l.status.toUpperCase() %>
              </span>
            </td>
            <td><%= formatDate(l.appliedAt) %></td>
            <td>
              <a href="/loans/<%= l.id %>" class="btn btn-secondary btn-sm">Manage</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
