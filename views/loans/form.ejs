<%- include('../partials/head.ejs', { title: 'Apply for Loan' }) %>
<%- include('../partials/nav.ejs') %>

<div style="max-width: 680px; margin: 1.5rem auto;">
  <div class="card">
    <div class="card-title">
      <span>Submit Loan Application</span>
      <a href="/loans" style="font-size: 0.85rem;">Back to Loans</a>
    </div>

    <form action="/loans" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="memberId">Borrower (Member) *</label>
        <select id="memberId" name="memberId" class="form-control" required>
          <option value="">-- Choose Member --</option>
          <% for (const m of members) { %>
            <option value="<%= m.id %>">
              <%= m.memberNo %> &mdash; <%= m.firstName %> <%= m.lastName %> (Savings: <%= formatMoney(m.totalSavingsCents) %>)
            </option>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="productId">Loan Product *</label>
        <select id="productId" name="productId" class="form-control" required>
          <option value="">-- Choose Loan Product --</option>
          <% for (const p of products) { %>
            <option value="<%= p.id %>">
              <%= p.name %> &mdash; <%= (p.interestRateBps / 100).toFixed(1) %>%/mo (<%= p.interestMethod %>), Max <%= p.maxTermMonths %> mos, Max <%= p.maxMultipleOfSavings %>x Savings
            </option>
          <% } %>
        </select>
      </div>

      <div class="grid grid-2">
        <div class="form-group">
          <label class="form-label" for="principal">Principal Amount (<%= org.currencySymbol %>) *</label>
          <input type="text" id="principal" name="principal" class="form-control" placeholder="1,000,000" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="termMonths">Repayment Period (Months) *</label>
          <input type="number" id="termMonths" name="termMonths" class="form-control" min="1" max="60" value="6" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="purpose">Loan Purpose</label>
        <input type="text" id="purpose" name="purpose" class="form-control" placeholder="e.g. Business inventory, school fees">
      </div>

      <div class="form-group">
        <label class="form-label">Guarantors (Select if required by product)</label>
        <select name="guarantors" class="form-control" multiple size="4">
          <% for (const m of members) { %>
            <option value="<%= m.id %>"><%= m.memberNo %> &mdash; <%= m.firstName %> <%= m.lastName %></option>
          <% } %>
        </select>
        <small style="color: var(--text-muted);">Hold Ctrl (or Cmd) to select multiple guarantors.</small>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="/loans" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Submit Application</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot.ejs') %>
